{
  "name": "lorenz-inequality-estimation",
  "version": "0.1.0",
  "description": "Numerical estimation of economic inequality and continuous Lorenz curve reconstruction from discrete quantiles",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./integration": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js"
    },
    "./interpolation": {
      "types": "./dist/interpolation/index.d.ts",
      "import": "./dist/interpolation/index.js"
    },
    "./regression": {
      "types": "./dist/regression/index.d.ts",
      "import": "./dist/regression/index.js"
    },
    "./simulation": {
      "types": "./dist/simulation/index.d.ts",
      "import": "./dist/simulation/index.js"
    },
    "./solvers": {
      "types": "./dist/solvers/index.d.ts",
      "import": "./dist/solvers/index.js"
    },
    "./tail": {
      "types": "./dist/tail/index.d.ts",
      "import": "./dist/tail/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:demo": "esbuild demo/src/main.ts --bundle --format=iife --outfile=demo/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsc benchmarks/runBenchmarks.ts --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck --outDir dist/benchmarks && node dist/benchmarks/benchmarks/runBenchmarks.js"
  },
  "keywords": [
    "numerical-analysis",
    "lorenz-curve",
    "gini-coefficient",
    "splines",
    "economics"
  ],
  "author": "Atanas Bobev",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.0"
  }
}
